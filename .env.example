# AI_API_KEY: Required for AI chat replies. Any OpenAI-compatible provider works
# (OpenAI, OpenRouter, Groq, Together, DeepSeek, xAI, Mistral, Ollama/LM Studio, ...).
AI_API_KEY="MY_AI_API_KEY"

# AI_BASE_URL: Optional. Base URL of the provider's OpenAI-compatible API.
# Defaults to OpenAI. Examples:
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   http://localhost:11434/v1              (local Ollama)
AI_BASE_URL="https://api.openai.com/v1"

# AI_MODEL: Optional. Model id sent to the provider. Defaults to gpt-4o-mini.
AI_MODEL="gpt-4o-mini"

# AI_MODELS: Optional. Comma-separated extra model ids offered in the app's model picker.
# AI_MODEL is always listed first.
AI_MODELS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
