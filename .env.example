# APIMyLlama server-only configuration. Never prefix these variables with VITE_.
APIMYLLAMA_API_KEY=""
# Full HTTPS endpoint for OpenAI-compatible chat completions, from the provider documentation.
APIMYLLAMA_CHAT_URL=""
# Model identifier supported by your APIMyLlama account.
APIMYLLAMA_MODEL=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
