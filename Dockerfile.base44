# Dev-only runtime image for the Base44 sandbox.
#
# The project's lockfile is a `bun.lock` (there is no package-lock.json), but the app
# itself is meant to run on Node (`npm run dev` -> `tsx server.ts`). This image pairs the
# Node runtime with the bun package manager instead of running the app on bun's runtime.
# No application source is copied in: docker-compose.base44.yml bind-mounts the checkout
# at /app, so edits are picked up without rebuilding.
FROM node:22

RUN npm install -g bun@1.4.4

WORKDIR /app
